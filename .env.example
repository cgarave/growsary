# Supabase Transaction Pooler URL (Used by Prisma Client for app queries on port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection URL (Used by Prisma CLI for migrations/push on port 5432)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

BETTER_AUTH_SECRET="growsary_super_secret_auth_key_2026_change_in_prod"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_MESSENGER_PAGE="YourStorePage"

# Gemini API Key for Admin AI Assistant
GEMINI_API_KEY="your_gemini_api_key_here"
